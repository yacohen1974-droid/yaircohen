rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin allowlist: to grant/revoke admin access, create/delete a document
    // in the `admins` collection whose ID is the lowercase email address —
    // via the Firestore console, no code or rules change needed. The document
    // itself can be empty; only its existence matters.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      // A signed-in user may only check their own admin doc.
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      // Managed exclusively via the Firebase console (which bypasses rules).
      allow write: if false;
    }

    // Site data — published content is world-readable
    match /sites/{site} {
      // Global settings — public (no auth needed)
      match /global/settings {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Pages — public (no auth needed)
      match /pages/{pageId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Blog posts — public (no auth needed)
      match /blogPosts/{postId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
