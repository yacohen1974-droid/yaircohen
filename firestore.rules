rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Site data — published content is world-readable
    match /sites/{site} {
      // Global settings — public (no auth needed)
      match /global/settings {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email in get(/databases/$(database)/documents/sites/$(site)/admin/emails).data.list;
      }

      // Pages — public (no auth needed)
      match /pages/{pageId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email in get(/databases/$(database)/documents/sites/$(site)/admin/emails).data.list;
      }

      // Blog posts — public (no auth needed)
      match /blogPosts/{postId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email in get(/databases/$(database)/documents/sites/$(site)/admin/emails).data.list;
      }

      // Admin emails list
      match /admin/emails {
        allow read, write: if request.auth != null && request.auth.token.email in get(/databases/$(database)/documents/sites/$(site)/admin/emails).data.list;
      }
    }
  }
}
