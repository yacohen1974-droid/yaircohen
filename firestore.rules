rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Keep this list in sync with ALLOWED_ADMIN_EMAILS in src/lib/site-config.ts
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'amirher@gmail.com',
        'yairmashkantaot@gmail.com',
        'yacohen1974@gmail.com'
      ];
    }

    // Site data — published content is world-readable
    match /sites/{site} {
      // Global settings — public (no auth needed)
      match /global/settings {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Pages — public (no auth needed)
      match /pages/{pageId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Blog posts — public (no auth needed)
      match /blogPosts/{postId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
